# Copy to .env. Local values match docker-compose.yml; prod swaps env vars only (ARCH §13).
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus
TEST_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_test
APP_URL=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
SESSION_DAYS=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digital Campus <no-reply@campus.local>"

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=campus
S3_ACCESS_KEY=campus
S3_SECRET_KEY=campus-secret
S3_FORCE_PATH_STYLE=true

# Empty = document import disabled.
ANTHROPIC_API_KEY=
IMPORT_MODEL=claude-sonnet-5-5
INSTITUTION_TZ=Asia/Kolkata
