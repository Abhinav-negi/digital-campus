# Copy to .env. Local values match `npm run db:start`; prod swaps env vars only (ARCH §13, D14).
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus
TEST_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_test
APP_URL=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
SESSION_DAYS=30

# Empty SMTP_HOST = emails are printed to the server log (dev).
# Real emails for free: Gmail App Password, see README "Real emails".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digital Campus <no-reply@campus.local>"

# Empty S3_ENDPOINT = files on local disk in .data/uploads (dev, tests).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=campus
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

INSTITUTION_TZ=Asia/Kolkata

# Prod seed only (SEED_MODE=prod): the chief admin's real inbox.
SEED_CHIEF_EMAIL=
