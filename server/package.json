{
  "name": "@campus/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "test": "node --env-file=../.env.example --env-file-if-exists=../.env --import ./test/setup.ts --import tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "gen:api": "node --env-file=../.env.example --import tsx --input-type=module -e \"const { openApiDocument } = await import('./src/lib/openapi.ts'); await import('./src/app.ts'); console.log(JSON.stringify(openApiDocument()))\" | openapi-typescript -o ../web/src/api/schema.d.ts",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:seed": "node --env-file=../.env.example --env-file-if-exists=../.env --import tsx prisma/seed.ts",
    "db:reset": "npm run db:seed",
    "prisma": "node --env-file=../.env.example --env-file-if-exists=../.env ../node_modules/prisma/build/index.js",
    "db:generate": "npm run prisma -- generate",
    "pretest": "npm run db:generate --silent",
    "pretypecheck": "npm run db:generate --silent",
    "prebuild": "npm run db:generate --silent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "nodemailer": "^10.0.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
